# Copy this file to .env and fill in real values. .env is gitignored — it must
# never be committed. See application.yml for how each of these is consumed.

# Google AI Studio API key (free tier). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides — safe to leave blank, sane defaults are in application.yml
GEMINI_MODEL=
GEMINI_BASE_URL=

# Random long string. Generate one with: openssl rand -base64 48
# (or just mash the keyboard — length matters more than memorability here)
TRUESIGHT_JWT_SECRET=

TRUESIGHT_JWT_EXPIRATION_MINUTES=

# Used only in the SEC EDGAR User-Agent header, per SEC Fair Access policy.
# Any contact address is fine; SEC does not verify it.
TRUESIGHT_CONTACT_EMAIL=
